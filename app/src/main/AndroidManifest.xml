<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="com.leanbitlab.leantype" />
        <package android:name="com.leanbitlab.leantype.offline" />
        <package android:name="com.leanbitlab.leantype.debug" />
        <package android:name="com.leanbitlab.leantype.offline.debug" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_plugin_gif"
        android:roundIcon="@mipmap/ic_plugin_gif_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LeanTypeGif">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <service
            android:name=".GifEngineService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.leanbitlab.leantype.gif.ENGINE" />
            </intent-filter>
        </service>

        <provider
            android:name=".storage.ThumbnailProvider"
            android:authorities="com.leanbitlab.leantype.gif.thumbs"
            android:exported="true"
            android:grantUriPermissions="false" />

    </application>

</manifest>
